# Copie para .env e ajuste ao hardware da maquina de testes.
# Os valores abaixo sao o ponto de partida; o que for usado de fato precisa
# ser registrado no artigo, junto com CPU, RAM e versao do sistema.

# --- Limites de recurso (iguais para os dois brokers) ---
# Dimensionados para a VM do WSL2 com 8 GB (padrao do Docker Desktop em uma
# maquina de 16 GB). Broker 3 + Postgres 2 + metricas 1 = 6 GB, deixando
# folga para a propria VM. Em maquina com mais RAM, subir estes valores e
# registrar os novos no artigo.
BROKER_CPUS=4
BROKER_MEMORY=3g
POSTGRES_CPUS=2
POSTGRES_MEMORY=2g
METRICS_CPUS=0.5
METRICS_MEMORY=512m

# --- PostgreSQL ---
POSTGRES_USER=pitwall
POSTGRES_PASSWORD=pitwall
POSTGRES_DB=pitwall
POSTGRES_PORT=5432

# --- Kafka ---
KAFKA_PORT=9092
KAFKA_PARTITIONS=4
KAFKA_HEAP_OPTS=-Xmx1536m -Xms1536m

# --- RabbitMQ ---
RABBIT_PORT=5672
RABBIT_UI_PORT=15672
RABBIT_USER=pitwall
RABBIT_PASSWORD=pitwall

# --- Observabilidade ---
PROMETHEUS_PORT=9090
CADVISOR_PORT=8080
