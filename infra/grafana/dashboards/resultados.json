          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT (target_rate / 1000) || ' mil' AS carga,\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY p50_ms) FILTER (WHERE architecture = 'kafka-direct') AS \"kafka-direct\",\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY p50_ms) FILTER (WHERE architecture = 'kafka-channels') AS \"kafka-channels\",\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY p50_ms) FILTER (WHERE architecture = 'kafka-pipelines') AS \"kafka-pipelines\",\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY p50_ms) FILTER (WHERE architecture = 'rabbitmq-direct') AS \"rabbitmq-direct\",\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY p50_ms) FILTER (WHERE architecture = 'rabbitmq-channels') AS \"rabbitmq-channels\",\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY p50_ms) FILTER (WHERE architecture = 'rabbitmq-pipelines') AS \"rabbitmq-pipelines\"\nFROM v_matrix\nWHERE valid AND source = '$source'\nGROUP BY target_rate\nORDER BY target_rate"
