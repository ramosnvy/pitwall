{
  "uid": "pitwall-logs",
  "title": "PitWall · Logs",
  "description": "Logs de todos os containers pitwall-*, filtráveis pelos rótulos da rodada.",
  "tags": [
    "pitwall"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "container",
        "label": "Container",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values(container)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": "pitwall-.+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "type": "query",
        "name": "architecture",
        "label": "Arquitetura",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values(architecture)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "type": "query",
        "name": "rate",
        "label": "Carga",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values(rate)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "type": "query",
        "name": "run_id",
        "label": "Rodada",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values(run_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "type": "textbox",
        "name": "busca",
        "label": "Busca",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "pitwall"
      ],
      "asDropdown": false,
      "title": "PitWall",
      "includeVars": false,
      "keepTime": true
    },
    {
      "type": "link",
      "title": "Replay 2D",
      "url": "http://localhost:3001",
      "targetBlank": true,
      "icon": "external link",
      "tooltip": "Replay das corridas (tools/race-replay)"
    }
  ],
  "panels": [
    {
      "type": "timeseries",
      "id": 1,
      "title": "Linhas de log por container",
      "description": "Volume de log. Um salto fora do fim de rodada costuma ser erro ou reconexão.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (container) (count_over_time({container=~\"$container\", architecture=~\"$architecture\", rate=~\"$rate\", run_id=~\"$run_id\"} |~ \"$busca\" [$__auto]))",
          "legendFormat": "{{container}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "logs",
      "id": 2,
      "title": "Avisos e erros",
      "description": "Linhas com aviso, erro, exceção ou falha.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=~\"$container\", architecture=~\"$architecture\", rate=~\"$rate\", run_id=~\"$run_id\"} |~ \"(?i)(aviso|warn|erro|error|exce|fail|queue full)\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    },
    {
      "type": "logs",
      "id": 3,
      "title": "Todos os logs",
      "description": "Filtros no topo; a caixa de busca aceita expressão regular.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=~\"$container\", architecture=~\"$architecture\", rate=~\"$rate\", run_id=~\"$run_id\"} |~ \"$busca\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    }
  ]
}
